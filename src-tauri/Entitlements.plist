<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime: the tuner (and outputs with inputs) need the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Tauri signs the sidecars with this file too. yt-dlp is a PyInstaller
       binary that unpacks and loads its own Python library at run time, which
       library validation would refuse (different Team ID). -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
