{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Woodshed",
  "mainBinaryName": "woodshed",
  "version": "0.1.0",
  "identifier": "dev.mongmeo.woodshed",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm binaries && pnpm stem-model && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Woodshed",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 22 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4OUMyNEM2QzQ3OEZBNTIKUldSUytuakV4aVNjNkZvY3VCelowY3A5VDkzL25HR0o1VlpZYlhWaUVIMFNYaU83MkQyQncrWDcK",
      "endpoints": ["https://github.com/mongmeo-dev/woodshed/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Music",
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "resources": {
      "../LICENSES/": "LICENSES/",
      "models/htdemucs_6s_fp32.mlmodelc/": "models/htdemucs_6s_fp32.mlmodelc/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./macos/en.lproj/InfoPlist.strings",
        "Resources/ko.lproj/InfoPlist.strings": "./macos/ko.lproj/InfoPlist.strings"
      }
    }
  }
}
